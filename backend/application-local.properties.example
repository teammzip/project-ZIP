# Copy to application-local.properties and fill in your own credentials.
# Never enter real credentials in this example file.
DB_URL=jdbc:mysql://localhost:3306/zip_test?connectionTimeZone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# Base64-encoded cryptographically random value of at least 32 bytes.
JWT_SECRET=

# Kakao Developers REST API key for map places (optional; empty = DB places only).
KAKAO_REST_KEY=

# Google social login (optional). Create an OAuth client in Google Cloud Console with the
# redirect URI http://localhost:8080/login/oauth2/code/google . Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver social login (optional). Register the callback URL
# http://localhost:8080/login/oauth2/code/naver in NAVER Developers. Leave blank to disable.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao social login (optional). Register the Redirect URI
# http://localhost:8080/login/oauth2/code/kakao in Kakao Developers. Leave blank to disable.
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
