# Copy to application-local.properties and fill in your own credentials.
# Never enter real credentials in this example file.
DB_URL=jdbc:mysql://localhost:3306/zip_test?connectionTimeZone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# Base64-encoded cryptographically random value of at least 32 bytes.
JWT_SECRET=

# Kakao Developers REST API key for map places (optional; empty = DB places only).
KAKAO_REST_KEY=
# Kakao free-quota guard (optional, defaults 30 and 30000): calls per user per minute and per server per day (Korea time).
# Keep the daily limit below the free quota shown in the Kakao Developers console; do not enable paid overage.
# Uncomment to change (an empty value would fail startup):
# KAKAO_PER_USER_PER_MINUTE=30
# KAKAO_DAILY_LIMIT=30000

# Google social login (optional). Create an OAuth client in Google Cloud Console with the
# redirect URI http://localhost:8080/login/oauth2/code/google . Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver social login (optional). Register the callback URL
# http://localhost:8080/login/oauth2/code/naver in NAVER Developers. Leave blank to disable.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao social login (optional). Register the Redirect URI
# http://localhost:8080/login/oauth2/code/kakao in Kakao Developers. Leave blank to disable.
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=

# Email verification (optional). Gmail: turn on 2-step verification, then create an "app password" and use it as MAIL_PASSWORD.
# Without MAIL_USERNAME/MAIL_PASSWORD sending fails (503). For development without a mail account set MAIL_LOG_ONLY=true:
# the 6-digit code is then printed in the server log instead. Never use it in production.
MAIL_LOG_ONLY=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# AI chat (Google AI Studio / Gemini API key). Or put it in secrets/gemini.properties
GEMINI_API_KEY=
