# 이 파일을 복사해서 .env.local 로 만들고 값을 바꿔 쓰세요. (.env.local 은 git 에 올라가지 않음)

# true(기본값): 백엔드 없이 브라우저 안의 가짜 API로 로그인·회원가입 동작
# false: 실제 백엔드 API 호출
VITE_USE_MOCK=true

# API 주소. 기본값 /api (개발 중에는 vite 프록시가 VITE_PROXY_TARGET 으로 넘겨줌)
VITE_API_BASE_URL=/api

# 개발 서버 프록시가 /api 요청을 넘길 백엔드 주소
VITE_PROXY_TARGET=http://localhost:8080

# 날씨 API (선택). 운영 시 동일 응답 형식의 서버 프록시 주소로 변경 가능.
# Open-Meteo 공개 API는 비상업용. 상업 운영 시 서버에서 유료 API 키를 관리하세요.
VITE_WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# Nominatim 검색 결과는 브라우저에 90일 캐시. 운영 시 서비스 전체의 호출 제한을 서버에서 관리하세요.
VITE_WEATHER_GEOCODING_URL=https://nominatim.openstreetmap.org/search
